{
  "name": "trustmesh-desktop",
  "private": true,
  "version": "0.2.2",
  "description": "TrustMesh — AI Agent 任务编排与项目管理平台（桌面版）",
  "author": "TrustMesh",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --port 5174\" \"wait-on tcp:127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "desktop:start": "electron .",
    "desktop:pack": "npm run build -- --base=./ && electron-builder --win nsis"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@open-file-viewer/core": "^0.1.44",
    "@open-file-viewer/react": "^0.1.44",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@rolldown/pluginutils": "^1.0.0-beta.27",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "^5.90.20",
    "@tanstack/react-query": "^5.90.21",
    "@types/three": "^0.185.4",
    "antd": "^5.24.0",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.0",
    "ky": "^1.14.3",
    "lodash-es": "^4.18.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.trustmesh.desktop",
    "productName": "TrustMesh",
    "icon": "build/icon.ico",
    "asar": true,
    "files": [
      "dist-v2/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "TrustMesh-Setup-${version}.exe",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TrustMesh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://175.27.135.91/api/v1/desktop/releases/feed"
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
